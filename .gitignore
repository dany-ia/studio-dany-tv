# private: device inventory, tokens, certs, camera frames, logs, pids
.local/
*.p12
*.pwd
*.pem
*.key
*.crt
watcher/certs/
watcher/frames/
watcher/*.pem
.env
# build output
app/**/.buildResult/
app/**/*.wgt
dist/
# tooling clone (installed separately)
.skills-src/
node_modules/
.DS_Store
# Tizen build output and IDE state
app/**/Debug/
app/**/Release/
app/**/.tizen-rds/
app/**/*.code-workspace
__pycache__/

# Spotify: TV-side config with the broker app key (packaged into the .wgt, never committed)
app/**/config.local.json

# secrets and signing material (belt and braces; the real state lives under .local/)
.env.*
!.env.example
*.pfx
*.jks
tokens.json
secrets.txt
secrets/
app/**/author-signature.xml
app/**/signature*.xml
app/**/.sign/
.sign/
*.sign
tizen-studio/
tizen-sdk-data/
# copy of the broker install directory, if ever synced back from the Mac Studio
studiodany/
# watcher pairing state outside .local/ (defensive)
watcher/pair*.json
watcher/pair*.txt
