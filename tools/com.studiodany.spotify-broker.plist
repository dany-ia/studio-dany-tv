<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template for the Spotify token broker. tools/broker-install.sh fills __NODE__ and __HOME__
     and installs it as ~/Library/LaunchAgents/com.studiodany.spotify-broker.plist on the broker machine. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.studiodany.spotify-broker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/studiodany/tools/spotify-broker.js</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/studiodany</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/studiodany-spotify-broker.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/studiodany-spotify-broker.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
